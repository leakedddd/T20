@model T20MVC.Models.PedidoVM
@using T20MVC.Models

@{
    ViewBag.Title = "Pedido";

    var carrito = ViewBag.carrito as List<RegistroDto> ?? new List<RegistroDto>();
    int items = carrito.Sum(x => x.cantidad);
    decimal subtotal = carrito.Sum(x => x.precio * x.cantidad);
    string label = items == 1 ? "producto" : "productos";
}

<link rel="stylesheet" href="~/Content/home.css" />
<link rel="stylesheet" href="~/Content/pedido.css" />

<div class="checkout-header">
    <h1>Pagar</h1>
    <div class="checkout-kpi">
        <span class="kpi-items">(@items @label)</span>
        <span class="kpi-total">S/ @subtotal.ToString("N2")</span>
    </div>
</div>

<div class="checkout-container">

    <!-- FORMULARIO -->
    <section class="checkout-main">
        <h3>Contacto</h3>

        <form asp-action="Pedido" method="post">
            @Html.AntiForgeryToken()

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger" style="background-color: #f8d7da; color: #721c24; padding: 12px 20px; border-radius: 4px; margin-bottom: 20px; border-left: 4px solid #dc3545;">
                    <strong>⚠️ Error:</strong> @ViewBag.Error
                </div>
            }

            <div class="form-grid">
                <div class="form-field">
                    <label>Dirección de envío *</label>
                    <input asp-for="direccion" class="input" required placeholder="Ej: Av. Lima 123, San Isidro" />
                </div>

                <hr class="section-divider" />

                <!-- MÉTODO DE PAGO -->
                <h3 style="margin: 20px 0 16px 0; font-weight: 700;">Método de Pago</h3>

                <div class="payment-icons">
                    <i class="fab fa-cc-visa" title="Visa"></i>
                    <i class="fab fa-cc-mastercard" title="Mastercard"></i>
                    <i class="fab fa-cc-amex" title="American Express"></i>
                    <i class="fas fa-credit-card" title="Otras tarjetas"></i>
                </div>

                <div class="form-field">
                    <label>Número de tarjeta *</label>
                    <input type="text"
                           class="input card-input"
                           placeholder="1234 5678 9012 3456"
                           maxlength="19"
                           id="cardNumber"
                           required />
                </div>

                <div class="form-field">
                    <label>Nombre del titular *</label>
                    <input type="text"
                           class="input"
                           placeholder="NOMBRE APELLIDO"
                           style="text-transform: uppercase;"
                           required />
                </div>

                <div class="form-row">
                    <div class="form-field">
                        <label>Fecha de expiración *</label>
                        <input type="text"
                               class="input"
                               placeholder="MM/AA"
                               maxlength="5"
                               id="cardExpiry"
                               required />
                    </div>
                    <div class="form-field">
                        <label>CVV *</label>
                        <input type="text"
                               class="input"
                               placeholder="123"
                               maxlength="4"
                               id="cardCVV"
                               required />
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-primary">
                        <i class="fas fa-lock"></i> Confirmar Pedido
                    </button>
                </div>
            </div>
        </form>
    </section>

    <!-- RESUMEN -->
    <aside class="checkout-sidebar">
        <div class="summary-card">
            <div class="summary-header">
                <h3>Tu Pedido</h3>
                <a class="summary-edit" href='@Url.Action("Carrito", "T20")'>EDITAR</a>
            </div>

            <table class="summary-table">
                <tbody>
                    <tr>
                        <td>@items @label</td>
                        <td class="align-right">S/ @subtotal.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td>Envío</td>
                        <td class="align-right">Gratis</td>
                    </tr>
                    <tr class="summary-total">
                        <td>Total</td>
                        <td class="align-right">S/ @subtotal.ToString("N2")</td>
                    </tr>
                </tbody>
            </table>

            <ul class="mini-items">
                @foreach (var it in carrito)
                {
                    var img = Url.Content($"~/Images/Shop/{it.codigo}.jpg");
                    <li class="mini-item">
                        <img src="@img" alt="@it.descripcion" />
                        <div class="mini-info">
                            <div class="mini-name">@it.descripcion</div>
                            <div class="mini-meta">Cantidad: @it.cantidad</div>
                            <div class="mini-price">
                                S/ @(it.precio.ToString("N2"))
                            </div>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </aside>
</div>

@section scripts {
<script>
    // Formateo automático de número de tarjeta (solo estético)
    document.getElementById('cardNumber')?.addEventListener('input', function(e) {
        let value = e.target.value.replace(/\s/g, '');
        let formattedValue = value.match(/.{1,4}/g)?.join(' ') || value;
        e.target.value = formattedValue;
    });

    // Formateo de fecha de expiración MM/AA
    document.getElementById('cardExpiry')?.addEventListener('input', function(e) {
        let value = e.target.value.replace(/\D/g, '');
        if (value.length >= 2) {
            value = value.substring(0, 2) + '/' + value.substring(2, 4);
        }
        e.target.value = value;
    });

    // Solo números en CVV
    document.getElementById('cardCVV')?.addEventListener('input', function(e) {
        e.target.value = e.target.value.replace(/\D/g, '');
    });
</script>
}
